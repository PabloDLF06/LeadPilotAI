# URL pública de la aplicación; se usa para enlaces y callbacks no sensibles.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: publishable/anon llega al navegador; secret/service role solo servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI es opcional si DEMO_MODE=true.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Reservadas para el proveedor de email; la versión actual registra simulaciones.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# n8n es opcional e interno. Solo activar tras configurar URL y secretos.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_ENABLED=false
N8N_CALLBACK_SECRET=
N8N_TIMEOUT_MS=5000
INTERNAL_AUTOMATION_SECRET=

# Reservadas para el workflow n8n; nunca se exponen al cliente.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Rate limit del formulario público; usa un salt aleatorio en producción.
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_SALT=change-me-in-production

# Permite ejecutar la demo sin OpenAI, Resend ni n8n.
DEMO_MODE=true
