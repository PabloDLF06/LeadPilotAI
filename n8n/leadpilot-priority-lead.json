    { "id": "24387142-d758-45a9-9950-b0afd3addd8a", "name": "Telegram priority alert", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [1120, 192], "parameters": { "resource": "message", "operation": "sendMessage", "chatId": "={{ $env.TELEGRAM_DEFAULT_CHAT_ID }}", "text": "={{ \"Lead \" + $(\"Validate HMAC and payload\").item.json.lead.reference + \" · \" + $(\"Validate HMAC and payload\").item.json.lead.priority.toUpperCase() + \" · score \" + $(\"Validate HMAC and payload\").item.json.lead.score + \"\\n\" + $(\"Validate HMAC and payload\").item.json.lead.full_name + \" · \" + $(\"Validate HMAC and payload\").item.json.lead.email + \"\\n\" + ($(\"Validate HMAC and payload\").item.json.analysis.summary || \"\") }}" } },
