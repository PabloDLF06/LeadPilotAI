    { "id": "69a64ae4-44fa-4a94-9d0e-ee434c7b9006", "name": "Validate HMAC and payload", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [224, 288], "parameters": { "mode": "runOnceForAllItems", "language": "javaScript", "jsCode": "const item = $input.first().json;\nconst body = item.body || item;\nconst headers = item.headers || {};\nconst timestamp = String(headers['x-leadpilot-timestamp'] || '');\nconst signature = String(headers['x-leadpilot-signature'] || '');\nconst event = String(headers['x-leadpilot-event'] || body.event || '');\nconst idempotencyKey = String(headers['x-leadpilot-idempotency-key'] || body.idempotency_key || '');\nconst rawBody = item.rawBody || JSON.stringify(body);\nconst crypto = require('crypto');\nconst expected = process.env.LEADPILOT_WEBHOOK_SECRET ? crypto.createHmac('sha256', process.env.LEADPILOT_WEBHOOK_SECRET).update(timestamp + '.' + rawBody).digest('hex') : '';\nconst age = Math.abs(Date.now() / 1000 - Number(timestamp));\nconst shapeValid = event === 'lead.priority_detected' && Boolean(idempotencyKey) && body.lead && body.analysis && Number(body.lead.score) >= 70;\nconst valid = Boolean(shapeValid && signature && expected && signature === expected && Number.isFinite(age) && age <= 300);\nreturn [{ json: { ...body, valid, event, idempotency_key: idempotencyKey, received_signature: signature, timestamp } }];" } },
